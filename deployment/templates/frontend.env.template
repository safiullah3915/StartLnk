# Empty string = relative URL — Nginx proxies /api/, /auth/ to Gunicorn
VITE_API_BASE_URL=

# Google OAuth Client ID (public key)
VITE_GOOGLE_CLIENT_ID={{GOOGLE_CLIENT_ID}}

# Application Base URL (for SEO canonical links, OG tags)
VITE_APP_URL=https://{{DOMAIN}}

# Environment label
VITE_ENV=production
