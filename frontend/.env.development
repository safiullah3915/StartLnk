# ── Development Environment ─────────────────────────────────────────────────
# Vite reads this automatically when running `npm run dev`
# Variables MUST start with VITE_ to be exposed to the browser

# Local Django dev server — Vite dev proxy will forward /api/ and /auth/ here
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=107351568402-etjf2vg4auc5iguelv5i7ghpfg4fkep2.apps.googleusercontent.com

# App base URL (for SEO canonical, OG URLs, sitemap)
VITE_APP_URL=http://localhost:5173

# Environment label
VITE_ENV=development
